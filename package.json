{
  "private": true,
  "name": "hell-dice-shooter",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run playtest",
    "deploy": "npm run build && devvit upload",
    "format": "npm run lint -- --fix",
    "lint": "biome check --error-on-warnings",
    "playtest": "devvit playtest",
    "publish": "npm run clean && npm run build && devvit publish",
    "test": "npm run test:types && npm run lint && npm run test:unit && npm run build",
    "test:types": "tsc --build src/server src/shared",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test src/**/*.test.ts"
  },
  "dependencies": {
    "@devvit/start": "0.13.7",
    "@devvit/web": "0.13.7",
    "devvit": "0.13.7",
    "gl-matrix": "^3.4.4",
    "phaser": "^3.90.0",
    "phaser3-rex-plugins": "^1.80.20",
    "twopointfive-phaser-3": "github:jamaalsawyerd/twopointfive-phaser-3#706a99d001e85c9cb48971ab93ad430a28803d6c",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "22.12.0",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.6"
  }
}
